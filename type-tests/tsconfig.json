{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "types": [],
    "skipLibCheck": false,
    "paths": {
      // Resolve the package name to the generated declarations under src/src so the
      // fixture reads like real consumer code while type-checking what we ship.
      // (paths are resolved relative to this tsconfig; no baseUrl needed since TS 4.1.)
      "@blues-inc/notehub-js": ["../src/src/index"]
    }
  },
  "include": ["smoke.ts"]
}
